# ============================================
# CONFIGURACIÓN DE FLASK
# ============================================
FLASK_APP=app
FLASK_ENV=development
SECRET_KEY=change-this-secret-key-in-production

# ============================================
# BASE DE DATOS - DESARROLLO
# ============================================
DATABASE_URL=mysql+pymysql://root:your-password@localhost:3306/isp_portal
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-password
DB_NAME=isp_portal

# ============================================
# BASE DE DATOS - TESTING
# ============================================
TESTING_DATABASE_URL=mysql+pymysql://root:your-password@localhost:3306/isp_portal_test

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=DEBUG

# ============================================
# CORS (opcional - configurar en producción)
# ============================================
# CORS_ORIGINS=http://localhost:3000,https://tudominio.com
